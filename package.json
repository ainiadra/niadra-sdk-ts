{
  "name": "@niadra/sdk",
  "version": "0.1.1",
  "description": "TypeScript SDK for Niadra, the shared customer memory for every AI agent in a company: context before the model call, history, tools and MCP.",
  "license": "Apache-2.0",
  "author": "Niadra",
  "homepage": "https://docs.niadra.com/en",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ainiadra/niadra-sdk-ts.git"
  },
  "bugs": "https://github.com/ainiadra/niadra-sdk-ts/issues",
  "keywords": [
    "niadra",
    "ai-agents",
    "agent-memory",
    "llm",
    "customer-context",
    "context-engineering",
    "mcp",
    "function-calling",
    "whatsapp",
    "voice-ai",
    "customer-support",
    "lgpd",
    "gdpr"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./livekit": {
      "import": {
        "types": "./dist/livekit.d.ts",
        "default": "./dist/livekit.js"
      },
      "require": {
        "types": "./dist/livekit.d.cts",
        "default": "./dist/livekit.cjs"
      }
    },
    "./elevenlabs": {
      "import": {
        "types": "./dist/elevenlabs.d.ts",
        "default": "./dist/elevenlabs.js"
      },
      "require": {
        "types": "./dist/elevenlabs.d.cts",
        "default": "./dist/elevenlabs.cjs"
      }
    },
    "./vapi": {
      "import": {
        "types": "./dist/vapi.d.ts",
        "default": "./dist/vapi.js"
      },
      "require": {
        "types": "./dist/vapi.d.cts",
        "default": "./dist/vapi.cjs"
      }
    },
    "./whatsapp": {
      "import": {
        "types": "./dist/whatsapp.d.ts",
        "default": "./dist/whatsapp.js"
      },
      "require": {
        "types": "./dist/whatsapp.d.cts",
        "default": "./dist/whatsapp.cjs"
      }
    },
    "./twilio": {
      "import": {
        "types": "./dist/twilio.d.ts",
        "default": "./dist/twilio.js"
      },
      "require": {
        "types": "./dist/twilio.d.cts",
        "default": "./dist/twilio.cjs"
      }
    },
    "./ai-sdk": {
      "import": {
        "types": "./dist/ai-sdk.d.ts",
        "default": "./dist/ai-sdk.js"
      },
      "require": {
        "types": "./dist/ai-sdk.d.cts",
        "default": "./dist/ai-sdk.cjs"
      }
    },
    "./mastra": {
      "import": {
        "types": "./dist/mastra.d.ts",
        "default": "./dist/mastra.js"
      },
      "require": {
        "types": "./dist/mastra.d.cts",
        "default": "./dist/mastra.cjs"
      }
    },
    "./langchain": {
      "import": {
        "types": "./dist/langchain.d.ts",
        "default": "./dist/langchain.js"
      },
      "require": {
        "types": "./dist/langchain.d.cts",
        "default": "./dist/langchain.cjs"
      }
    },
    "./openai-agents": {
      "import": {
        "types": "./dist/openai-agents.d.ts",
        "default": "./dist/openai-agents.js"
      },
      "require": {
        "types": "./dist/openai-agents.d.cts",
        "default": "./dist/openai-agents.cjs"
      }
    },
    "./anthropic": {
      "import": {
        "types": "./dist/anthropic.d.ts",
        "default": "./dist/anthropic.js"
      },
      "require": {
        "types": "./dist/anthropic.d.cts",
        "default": "./dist/anthropic.cjs"
      }
    },
    "./google-genai": {
      "import": {
        "types": "./dist/google-genai.d.ts",
        "default": "./dist/google-genai.js"
      },
      "require": {
        "types": "./dist/google-genai.d.cts",
        "default": "./dist/google-genai.cjs"
      }
    },
    "./bedrock": {
      "import": {
        "types": "./dist/bedrock.d.ts",
        "default": "./dist/bedrock.js"
      },
      "require": {
        "types": "./dist/bedrock.d.cts",
        "default": "./dist/bedrock.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "runtimes": "pnpm build && deno run --no-prompt test/runtimes/smoke.mjs && deno run --no-prompt test/runtimes/webhooks.mjs && bun test/runtimes/smoke.mjs && bun test/runtimes/webhooks.mjs && node test/runtimes/workerd.mjs && node test/runtimes/edge.mjs",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.75",
    "@ai-sdk/provider": "4.0.18",
    "@anthropic-ai/sdk": "0.128.0",
    "@aws-sdk/client-bedrock-runtime": "3.1140.0",
    "@edge-runtime/vm": "5.0.0",
    "@elevenlabs/elevenlabs-js": "2.69.0",
    "@eslint/js": "^10.0.1",
    "@google/genai": "2.24.0",
    "@langchain/core": "1.2.12",
    "@langchain/langgraph": "1.4.17",
    "@langchain/openai": "1.5.13",
    "@livekit/agents": "1.9.0",
    "@mastra/core": "1.71.0",
    "@openai/agents": "0.18.0",
    "@types/node": "^24.13.6",
    "@vapi-ai/server-sdk": "2.0.1",
    "ai": "7.0.114",
    "eslint": "^10.0.0",
    "hono": "4.13.9",
    "miniflare": "4.20260730.0",
    "tsup": "^8.5.1",
    "twilio": "6.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "zod": "4.6.5"
  },
  "packageManager": "pnpm@10.32.1",
  "typesVersions": {
    "*": {
      "livekit": [
        "./dist/livekit.d.ts"
      ],
      "elevenlabs": [
        "./dist/elevenlabs.d.ts"
      ],
      "vapi": [
        "./dist/vapi.d.ts"
      ],
      "whatsapp": [
        "./dist/whatsapp.d.ts"
      ],
      "twilio": [
        "./dist/twilio.d.ts"
      ],
      "ai-sdk": [
        "./dist/ai-sdk.d.ts"
      ],
      "mastra": [
        "./dist/mastra.d.ts"
      ],
      "langchain": [
        "./dist/langchain.d.ts"
      ],
      "openai-agents": [
        "./dist/openai-agents.d.ts"
      ],
      "anthropic": [
        "./dist/anthropic.d.ts"
      ],
      "google-genai": [
        "./dist/google-genai.d.ts"
      ],
      "bedrock": [
        "./dist/bedrock.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "@langchain/core": "^1.0.0",
    "@livekit/agents": "^1.9.0",
    "@mastra/core": "^1.0.0",
    "@openai/agents": ">=0.18.0 <1",
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@livekit/agents": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "@mastra/core": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
