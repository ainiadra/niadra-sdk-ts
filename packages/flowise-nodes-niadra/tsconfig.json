{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "noEmit": true,
    "paths": {
      "@niadra/sdk": [
        "../../src/index.ts"
      ],
      "@niadra/sdk/*": [
        "../../src/integrations/*.ts"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ]
}
